<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VVIP MONITORING - BHARADAKSA CLOUD</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap" rel="stylesheet">
    
    <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-app.js"></script>
    <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-database.js"></script>

    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="theme-color" content="#0f172a">

    <style>
        body { background: radial-gradient(circle at top left, #0f172a, #1e3a8a, #020617); background-attachment: fixed; min-height: 100vh; color: #f8fafc; font-family: 'Inter', sans-serif; }
        .glass-panel { background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.1); }
        .bg-bpjs { background: linear-gradient(135deg, #065f46, #064e3b); border: 2px solid #10b981; }
        .bg-polri { background: linear-gradient(135deg, #991b1b, #7f1d1d); border: 2px solid #ef4444; }
        .bg-umum { background: linear-gradient(135deg, #1e40af, #1e3a8a); border: 2px solid #3b82f6; }
        .bg-asuransi { background: linear-gradient(135deg, #6b21a8, #581c87); border: 2px solid #a855f7; }
        .bg-jasa-raharja { background: linear-gradient(135deg, #92400e, #78350f); border: 2px solid #f59e0b; }
        .room-empty { background: rgba(255, 255, 255, 0.03); border: 1px dashed rgba(255, 255, 255, 0.2); opacity: 0.6; }
        input, select, textarea { background: rgba(255, 255, 255, 0.08) !important; border: 1px solid rgba(255, 255, 255, 0.1) !important; color: white !important; outline: none; }
        select option { background-color: #0f172a !important; color: white !important; }
        .custom-scroll::-webkit-scrollbar { width: 4px; }
        .custom-scroll::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); border-radius: 10px; }

        /* CSS KHUSUS CETAK SURAT */
        #print-area { display: none; }
        @media print {
            @page { margin: 0; }
            body * { visibility: hidden; }
            #print-area, #print-area * { visibility: visible; }
            #print-area {
                display: block !important;
                position: absolute;
                left: 0; top: 0; width: 100%;
                color: black !important;
                background: white !important;
                padding: 1.5cm;
                font-family: 'Times New Roman', Times, serif;
                font-size: 12pt;
            }
            .kop-surat { text-align: center; border-bottom: 2px solid black; margin-bottom: 20px; padding-bottom: 10px; }
            .judul-surat { text-align: center; font-weight: bold; text-decoration: underline; margin: 30px 0; font-size: 14pt; }
            .isi-surat table td { padding: 6px 0; vertical-align: top; }
            .tanda-tangan-container { margin-top: 50px; display: flex; justify-content: flex-end; }
            .tanda-tangan-box { text-align: center; min-width: 280px; }
            .nama-dokter-print { 
                font-weight: bold; 
                text-decoration: underline; 
                white-space: nowrap; 
                display: inline-block;
                margin-top: 70px;
            }
        }
    </style>
</head>
<body class="p-4 lg:p-6 text-sm">

    <header class="mb-6 flex flex-col md:flex-row justify-between items-center gap-4">
        <div>
            <h1 class="text-3xl font-black tracking-tighter bg-clip-text text-transparent bg-gradient-to-r from-blue-400 to-emerald-400 uppercase leading-none">VVIP BHARADAKSA CLOUD</h1>
            <h2 class="text-xl font-black tracking-tighter bg-clip-text text-transparent bg-gradient-to-r from-blue-400 to-emerald-400 uppercase leading-none mt-1">RUMKIT BHAYANGKARA PALU</h2>
            <p id="current-month-label" class="text-blue-300 tracking-[0.4em] font-bold opacity-60 uppercase mt-2 text-xs"></p>
        </div>
        <div class="flex gap-2">
            <button onclick="exportToExcel()" class="text-[10px] bg-emerald-600/20 hover:bg-emerald-600 px-4 py-2 rounded-xl border border-emerald-500/50 transition-all font-black uppercase">⬇ DOWNLOAD EXCEL</button>
            <button onclick="resetSystem()" class="text-[10px] bg-red-600/20 hover:bg-red-600 px-4 py-2 rounded-xl border border-red-500/50 transition-all font-black uppercase">⚠️ RESET CLOUD</button>
        </div>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <div class="lg:col-span-4 space-y-6">
            <div class="glass-panel p-5 rounded-3xl border-l-4 border-blue-500 shadow-2xl">
                <h2 class="font-black text-blue-200 mb-4 uppercase tracking-widest flex items-center gap-2 text-xs">
                    <span class="w-2 h-2 bg-blue-400 rounded-full animate-pulse"></span> INPUT PASIEN BARU
                </h2>
                <form id="patient-form" class="space-y-3 font-bold">
                    <div class="grid grid-cols-3 gap-2">
                        <input type="text" id="no_rm" placeholder="NO RM" class="col-span-1 p-2.5 rounded-xl uppercase text-xs" required>
                        <input type="text" id="nama" placeholder="Nama Pasien" class="col-span-2 p-2.5 rounded-xl text-xs uppercase" required>
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <input type="number" id="umur" placeholder="Umur" class="p-2.5 rounded-xl text-xs" required>
                        <input type="text" id="diagnosa" placeholder="Diagnosa" class="p-2.5 rounded-xl text-xs uppercase">
                    </div>
                    <input type="text" id="alamat" placeholder="Alamat" class="w-full p-2.5 rounded-xl text-xs uppercase">
                    <select id="dokter-select" class="w-full p-2.5 rounded-xl text-xs" required></select>
                    <div class="grid grid-cols-2 gap-2">
                        <select id="pilih-bed" class="w-full p-2.5 rounded-xl text-xs" required>
                            <option value="">PILIH BED</option>
                        </select>
                        <select id="penjamin" class="w-full p-2.5 rounded-xl text-xs">
                            <option value="BPJS KESEHATAN">BPJS</option>
                            <option value="ANGGOTA POLRI">ANGGOTA POLRI</option>
                            <option value="KELUARGA POLRI">KLRG POLRI</option>
                            <option value="UMUM">UMUM</option>
                            <option value="ASURANSI SWASTA">ASURANSI</option>
                            <option value="JASA RAHARJA">JASA RAHARJA</option>
                        </select>
                    </div>
                    <div class="space-y-1">
                        <label class="text-[9px] text-blue-300 ml-1 uppercase">Tgl Masuk</label>
                        <input type="date" id="tgl_masuk" class="w-full p-2.5 rounded-xl text-xs" required>
                    </div>
                    <button type="submit" id="btn-submit" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-black py-3 rounded-xl uppercase tracking-widest transition-all text-xs shadow-lg shadow-blue-500/20">SIMPAN KE CLOUD</button>
                </form>
            </div>

            <div class="glass-panel p-5 rounded-3xl border-l-4 border-emerald-500">
                <h2 class="font-black text-emerald-400 mb-3 uppercase tracking-widest italic text-xs">Statistik Bulan Ini</h2>
                <div id="report-pasien-list" class="space-y-1 mb-4 text-[10px]"></div>
                <div class="pt-2 border-t border-white/10">
                    <p class="text-[9px] opacity-50 mb-1 font-bold uppercase">Total Hari Perawatan</p>
                    <div id="report-hari-list" class="space-y-1 text-[10px]"></div>
                </div>
            </div>

            <div class="glass-panel p-5 rounded-3xl border-l-4 border-purple-500">
                <h2 class="font-black text-purple-400 mb-3 uppercase tracking-widest text-xs">Master DPJP</h2>
                <div class="flex gap-2 mb-3">
                    <input type="text" id="input-dpjp-baru" placeholder="Contoh: dr. Nama, Sp.PD" class="flex-1 p-2 rounded-lg text-xs">
                    <button onclick="tambahDPJP()" class="bg-purple-600 hover:bg-purple-500 px-4 rounded-lg font-black">+</button>
                </div>
                <div id="list-dpjp-container" class="space-y-1 max-h-32 overflow-y-auto custom-scroll pr-2"></div>
            </div>
        </div>

        <div class="lg:col-span-8 space-y-6">
            <div class="glass-panel p-6 rounded-3xl shadow-xl">
                <h2 class="font-black text-blue-200 mb-6 uppercase text-xs tracking-[0.3em] text-center italic underline decoration-blue-500/50 underline-offset-8">Bed Monitoring VVIP</h2>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4" id="room-container"></div>
            </div>

            <div class="glass-panel rounded-3xl overflow-hidden border border-white/5 shadow-xl">
                <div class="bg-white/5 p-4 flex flex-col md:flex-row justify-between items-center gap-4 border-b border-white/5">
                    <div class="flex items-center gap-3 w-full md:w-auto">
                        <span class="font-black uppercase tracking-widest text-blue-300 text-xs">Log Pasien</span>
                        <input type="text" id="tableSearch" onkeyup="filterData()" placeholder="Cari Nama/RM..." class="px-4 py-1.5 rounded-full text-[10px] w-full md:w-64">
                    </div>
                    <select id="filter-status" onchange="filterData()" class="px-3 py-1.5 rounded-full font-black uppercase bg-white/10 text-[10px]">
                        <option value="Aktif">SEDANG DIRAWAT</option>
                        <option value="Pulang">RIWAYAT PULANG</option>
                    </select>
                </div>
                <div class="overflow-x-auto max-h-[450px] custom-scroll">
                    <table class="w-full text-left">
                        <thead class="text-blue-300 font-black uppercase bg-white/10 sticky top-0 text-[10px] z-10">
                            <tr>
                                <th class="p-4">Pasien</th>
                                <th class="p-4">Bed / DPJP</th>
                                <th class="p-4">Durasi & Tgl</th>
                                <th class="p-4">Penjamin</th>
                                <th class="p-4 text-center">Aksi</th>
                            </tr>
                        </thead>
                        <tbody id="master-table-body" class="divide-y divide-white/5 text-xs"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div id="print-area">
        <div class="kop-surat">
            <p style="margin:0; font-size: 14pt; font-weight: bold;">KEPOLISIAN DAERAH SULAWESI TENGAH</p>
            <p style="margin:0; font-size: 14pt; font-weight: bold;">RUMAH SAKIT BHAYANGKARA TK.III PALU</p>
            <p style="margin:0; font-size: 10pt; font-style: italic;">Jl. Dr. Suharso Lrg.III No.02 Palu. Telp. 0451-429714</p>
        </div>
        <div class="judul-surat">SURAT KETERANGAN LEPAS PERAWATAN</div>
        <div class="isi-surat">
            <p>Dengan ini menerangkan bahwa :</p>
            <table style="width: 100%; margin-left: 20px;">
                <tr><td width="200">Nama</td><td>: <span id="out-nama" style="font-weight:bold; text-transform: uppercase;"></span></td></tr>
                <tr><td>Umur</td><td>: <span id="out-umur"></span> Tahun</td></tr>
                <tr><td>Pekerjaan</td><td>: Polri/ PNS/Swasta/Pelajar/ Mahasiswa</td></tr>
                <tr><td>Pangkat/NRP</td><td>: ....................................................</td></tr>
                <tr><td>Alamat</td><td>: <span id="out-alamat" style="text-transform: uppercase;"></span></td></tr>
                <tr><td>Masuk Rumah Sakit</td><td>: <span id="out-masuk"></span></td></tr>
                <tr><td>Keluar Rumah Sakit</td><td>: <span id="out-keluar"></span></td></tr>
                <tr><td>Diagnosa</td><td>: <span id="out-diagnosa" style="font-weight:bold; text-transform: uppercase;"></span></td></tr>
            </table>
            <p style="margin-top: 40px;">Demikian surat keterangan ini dibuat untuk digunakan sebagaimana perlunya.</p>
        </div>
        
        <div class="tanda-tangan-container">
            <div class="tanda-tangan-box">
                <p>Palu, <span id="out-sekarang"></span></p>
                <p>Dokter Pemeriksa,</p>
                <div class="nama-dokter-print" id="out-dpjp"></div>
            </div>
        </div>
    </div>

    <script>
        const firebaseConfig = {
            apiKey: "AIzaSyDIpbcap68DbzNWsRQ8Pn-rQVokKA7cz0s",
            authDomain: "register-bhara-daksa.firebaseapp.com",
            databaseURL: "https://register-bhara-daksa-default-rtdb.asia-southeast1.firebasedatabase.app",
            projectId: "register-bhara-daksa",
            storageBucket: "register-bhara-daksa.firebasestorage.app",
            messagingSenderId: "762947418767",
            appId: "1:762947418767:web:9a67bc93d3366863654efa"
        };

        if (!firebase.apps.length) firebase.initializeApp(firebaseConfig);
        const db = firebase.database();

        let dbPasien = [];
        let listDokter = [];
        const masterBedList = [
            "BHARADAKSA 01", "BHARADAKSA 02", "BHARADAKSA 03", "BHARADAKSA 04", 
            "BHARADAKSA 05-A", "BHARADAKSA 05-B", "BHARADAKSA 06-A", "BHARADAKSA 06-B", 
            "BHARADAKSA 07-A", "BHARADAKSA 07-B", "BHARADAKSA 08-A", "BHARADAKSA 08-B", "TERATAI 7A", "TERATAI 7B"
        ];
        const penjaminList = ["BPJS KESEHATAN", "ANGGOTA POLRI", "KELUARGA POLRI", "UMUM", "ASURANSI SWASTA", "JASA RAHARJA"];

        db.ref('master_dokter').on('value', (snapshot) => {
            listDokter = snapshot.exists() ? snapshot.val() : ["dr. Andi Pratama, Sp.PD"];
            renderDPJP();
        });

        db.ref('pasien').on('value', (snapshot) => {
            const data = snapshot.val();
            dbPasien = data ? Object.values(data) : [];
            updateUI();
        });

        function getDays(inDate, outDate) {
            const start = new Date(inDate);
            const end = outDate ? new Date(outDate) : new Date();
            start.setHours(0,0,0,0);
            end.setHours(0,0,0,0);
            const diff = Math.ceil((end - start) / (1000 * 60 * 60 * 24));
            return diff <= 0 ? 1 : diff;
        }

        function updateUI() {
            const container = document.getElementById('room-container');
            const selBed = document.getElementById('pilih-bed');
            container.innerHTML = '';
            selBed.innerHTML = '<option value="">PILIH BED</option>';
            const aktifPasien = dbPasien.filter(p => p.status === 'Aktif');

            masterBedList.forEach(bedId => {
                const p = aktifPasien.find(pasien => pasien.bed === bedId);
                const div = document.createElement('div');
                if(p) {
                    let colorClass = 'bg-umum';
                    if(p.penjamin === "BPJS KESEHATAN") colorClass = 'bg-bpjs';
                    else if(p.penjamin.includes("POLRI")) colorClass = 'bg-polri';
                    else if(p.penjamin === "ASURANSI SWASTA") colorClass = 'bg-asuransi';
                    else if(p.penjamin === "JASA RAHARJA") colorClass = 'bg-jasa-raharja';
                    div.className = `${colorClass} p-3 rounded-2xl flex flex-col justify-between min-h-[135px] shadow-xl border-t-4 border-white/20 transform hover:scale-[1.02] transition-all cursor-pointer`;
                    div.innerHTML = `<div><div class="bg-black/40 px-2 py-1 rounded-lg border border-white/20 inline-block mb-2"><span class="text-[12px] font-black text-white uppercase">${bedId}</span></div><p class="text-[15px] font-black leading-tight text-white uppercase truncate">${p.nama}</p><p class="text-[10px] text-white/80 italic font-bold mt-1 truncate">${p.dpjp}</p></div><div class="text-right mt-2"><span class="text-[9px] font-black px-2 py-0.5 rounded bg-white/20 text-white italic">${p.penjamin.split(' ')[0]}</span></div>`;
                } else {
                    div.className = `room-empty p-3 rounded-2xl flex flex-col justify-between min-h-[135px]`;
                    div.innerHTML = `<p class="text-[12px] font-black opacity-50 text-white uppercase">${bedId}</p><p class="text-center pb-4 text-2xl font-black opacity-10 italic text-white uppercase">KOSONG</p>`;
                    selBed.add(new Option(bedId, bedId));
                }
                container.appendChild(div);
            });
            calculateStats();
            filterData();
        }

        function calculateStats() {
            const now = new Date();
            const dataBulanIni = dbPasien.filter(p => {
                const d = new Date(p.tgl_masuk);
                return d.getMonth() === now.getMonth() && d.getFullYear() === now.getFullYear();
            });
            let hPasien = ""; let hHari = ""; let tPasien = 0; let tHari = 0;
            penjaminList.forEach(pen => {
                const penData = dataBulanIni.filter(p => p.penjamin === pen);
                let penHari = 0;
                penData.forEach(p => { penHari += getDays(p.tgl_masuk, p.tgl_keluar); });
                tPasien += penData.length; tHari += penHari;
                hPasien += `<div class="flex justify-between items-center"><span>${pen}</span><span class="font-black text-white">${penData.length}</span></div>`;
                hHari += `<div class="flex justify-between items-center"><span>${pen}</span><span class="font-black text-white">${penHari} HR</span></div>`;
            });
            document.getElementById('report-pasien-list').innerHTML = hPasien + `<div class="border-t border-white/20 mt-1 pt-1 flex justify-between font-black text-emerald-400"><span>TOTAL</span><span>${tPasien}</span></div>`;
            document.getElementById('report-hari-list').innerHTML = hHari + `<div class="border-t border-white/20 mt-1 pt-1 flex justify-between font-black text-amber-400"><span>TOTAL</span><span>${tHari}</span></div>`;
        }

        function filterData() {
            const tbody = document.getElementById('master-table-body');
            const statusFilter = document.getElementById('filter-status').value;
            const searchTerm = document.getElementById('tableSearch').value.toUpperCase();
            tbody.innerHTML = '';
            const filtered = dbPasien.filter(p => (p.status === statusFilter) && (p.nama.includes(searchTerm) || p.no_rm.includes(searchTerm))).sort((a, b) => b.id - a.id);
            filtered.forEach(p => {
                const diffDays = getDays(p.tgl_masuk, p.tgl_keluar);
                tbody.innerHTML += `
                    <tr class="hover:bg-white/5 border-b border-white/5">
                        <td class="p-4">
                            <div class="text-blue-400 font-bold text-[9px] uppercase">${p.no_rm}</div>
                            <div class="font-bold text-white uppercase">${p.nama} (${p.umur} Th)</div>
                        </td>
                        <td class="p-4">
                            <div class="font-black text-blue-300 text-[10px] uppercase">${p.bed}</div>
                            <div class="text-[10px] opacity-70 italic">${p.dpjp}</div>
                        </td>
                        <td class="p-4">
                            <div class="flex flex-col gap-1 text-[10px]">
                                <div class="flex items-center gap-2"><span class="bg-emerald-500/20 text-emerald-400 px-1 rounded text-[8px]">IN</span>${p.tgl_masuk}</div>
                                ${p.status === 'Pulang' ? `<div class="flex items-center gap-2"><span class="bg-red-500/20 text-red-400 px-1 rounded text-[8px]">OUT</span>${p.tgl_keluar}</div>` : `<div class="text-amber-400 font-black animate-pulse uppercase">${diffDays} HARI RAWAT</div>`}
                            </div>
                        </td>
                        <td class="p-4 font-bold opacity-70 text-[9px] uppercase">${p.penjamin}</td>
                        <td class="p-4 text-center">
                            <div class="flex flex-col gap-1">
                                ${p.status === 'Aktif' ? `<button onclick="checkout('${p.id}')" class="bg-blue-600/50 hover:bg-blue-600 text-[9px] font-black py-1 px-3 rounded-lg transition-all">PULANG</button>` : ''}
                                <button onclick="cetakSKLP('${p.id}')" class="bg-emerald-600/30 hover:bg-emerald-600 text-emerald-300 hover:text-white text-[9px] font-black py-1 px-3 rounded-lg transition-all">CETAK SKLP</button>
                                <button onclick="hapusData('${p.id}')" class="bg-red-600/10 hover:bg-red-600 text-red-400 hover:text-white text-[9px] font-black py-1 px-3 rounded-lg transition-all">HAPUS</button>
                            </div>
                        </td>
                    </tr>`;
            });
        }

        document.getElementById('patient-form').onsubmit = (e) => {
            e.preventDefault();
            const id = Date.now().toString();
            const data = {
                id, no_rm: document.getElementById('no_rm').value.toUpperCase(),
                nama: document.getElementById('nama').value.toUpperCase(),
                umur: document.getElementById('umur').value,
                diagnosa: document.getElementById('diagnosa').value.toUpperCase(),
                alamat: document.getElementById('alamat').value.toUpperCase(),
                dpjp: document.getElementById('dokter-select').value,
                tgl_masuk: document.getElementById('tgl_masuk').value,
                bed: document.getElementById('pilih-bed').value,
                penjamin: document.getElementById('penjamin').value,
                status: 'Aktif'
            };
            db.ref('pasien/' + id).set(data).then(() => e.target.reset());
        };

        function checkout(id) {
            const tgl = prompt("Tanggal Pulang (YYYY-MM-DD):", new Date().toISOString().split('T')[0]);
            if(tgl) db.ref('pasien/' + id).update({ tgl_keluar: tgl, status: 'Pulang' });
        }

        function hapusData(id) {
            if(confirm('Hapus permanen data ini?')) db.ref('pasien/' + id).remove();
        }

        // FUNGSI TAMBAH DOKTER TANPA .toUpperCase()
        function tambahDPJP() {
            const name = document.getElementById('input-dpjp-baru').value.trim();
            if(name && !listDokter.includes(name)) {
                listDokter.push(name);
                db.ref('master_dokter').set(listDokter);
                document.getElementById('input-dpjp-baru').value = '';
            }
        }

        function renderDPJP() {
            const select = document.getElementById('dokter-select');
            const container = document.getElementById('list-dpjp-container');
            select.innerHTML = '<option value="">PILIH DPJP</option>';
            listDokter.forEach(doc => select.add(new Option(doc, doc)));
            container.innerHTML = listDokter.map((doc, idx) => `
                <div class="flex justify-between items-center bg-white/5 p-2 rounded text-[10px] font-bold border border-white/5 mb-1">
                    <span>${doc}</span>
                    <button onclick="hapusDPJP(${idx})" class="text-red-400 px-2 font-black">×</button>
                </div>`).join('');
        }

        function hapusDPJP(idx) {
            if(confirm('Hapus dokter?')) {
                listDokter.splice(idx, 1);
                db.ref('master_dokter').set(listDokter);
            }
        }

        function cetakSKLP(id) {
            const p = dbPasien.find(item => item.id === id);
            if(!p) return;
            document.getElementById('out-nama').innerText = p.nama;
            document.getElementById('out-umur').innerText = p.umur;
            document.getElementById('out-alamat').innerText = p.alamat || "-";
            document.getElementById('out-masuk').innerText = p.tgl_masuk;
            document.getElementById('out-keluar').innerText = p.tgl_keluar || "-";
            document.getElementById('out-diagnosa').innerText = p.diagnosa || "-";
            document.getElementById('out-dpjp').innerText = "( " + p.dpjp + " )";
            document.getElementById('out-sekarang').innerText = new Date().toLocaleDateString('id-ID', {day:'numeric', month:'long', year:'numeric'});
            window.print();
        }

        function generateCSV(dataArray, filename) {
            let csv = "No RM,Nama,Umur,Diagnosa,Alamat,Bed,DPJP,Penjamin,Tgl Masuk,Tgl Keluar,Status\n";
            dataArray.forEach(p => { csv += `"${p.no_rm}","${p.nama}","${p.umur}","${p.diagnosa || '-'}","${p.alamat || '-'}","${p.bed}","${p.dpjp}","${p.penjamin}","${p.tgl_masuk}","${p.tgl_keluar || '-'}","${p.status}"\n`; });
            const blob = new Blob(["\ufeff", csv], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement("a");
            link.href = URL.createObjectURL(blob);
            link.download = `${filename}.csv`;
            link.click();
        }

        function exportToExcel() {
            generateCSV(dbPasien, `VVIP_BHARADAKSA_FULL_REKAP_${new Date().toISOString().split('T')[0]}`);
        }

        function resetSystem() {
            if(prompt("Ketik 'HAPUS' untuk mengosongkan data cloud.") === 'HAPUS') {
                db.ref('pasien').remove();
                alert("Cloud Reset Berhasil.");
            }
        }

        function init() {
            const now = new Date();
            document.getElementById('tgl_masuk').value = now.toISOString().split('T')[0];
            const monthNames = ["JANUARI", "FEBRUARI", "MARET", "APRIL", "MEI", "JUNI", "JULI", "AGUSTUS", "SEPTEMBER", "OKTOBER", "NOVEMBER", "DESEMBER"];
            document.getElementById('current-month-label').innerText = `${monthNames[now.getMonth()]} ${now.getFullYear()}`;
        }
        init();
    </script>
</body>
</html>
